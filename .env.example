# ============================================================
# rest-api - example environment configuration
# Copy this file to .env and adjust as needed.
# Variables already present in the real environment take priority
# over values in .env.
# ============================================================

# --- Application -------------------------------------------------
APP_NAME=rest-api
APP_ENV=development            # development | staging | production
APP_VERSION=0.1.0

# --- HTTP server -------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Public base URL used to build absolute URLs in responses (e.g. streaming
# proxy links). Set this to the public URL behind your reverse proxy,
# otherwise the host is derived from the incoming request (unreliable behind
# nginx unless Host/X-Forwarded-* are forwarded).
PUBLIC_BASE_URL=https://api.dnld.app

# Optional logged-in Instagram session cookie, loaded from a JSON file in
# cookie/ (format: [{"name": "sessionid", "value": "...", "domain": ".instagram.com"}]).
# When set, Instagram posts/reels are resolved through the official GraphQL
# API so the response includes full metadata (author, caption, likes, views,
# dimensions, duration, etc.) instead of just download URLs from the scraper
# fallbacks. Leave empty to keep using the anonymous scraper chain only.
INSTAGRAM_COOKIE=

# Facebook / TikTok / Pinterest / Threads logged-in cookies for the native
# downloaders. Each value is a path to a JSON file in cookie/ with the same
# format as above. Leave empty to fetch anonymously.
FACEBOOK_COOKIE=
TIKTOK_COOKIE=
PINTEREST_COOKIE=
THREADS_COOKIE=

# Optional dnld.app API key (ra_...) pre-filled into the Scalar API reference
# at the root of this API so the Test Request feature can call the endpoints
# without the reader pasting a key manually. Generate one with:
#   go run ./cmd/devkey -name docs -role user -plan pro -key-name scalar-docs
# Leave empty to let readers paste their own key in the docs UI.
DOCS_API_KEY=

# --- Cloudflare R2 (opsional) -----------------------------------
# Akun R2 dalam satu JSON array. Kosong = R2 disabled.
# Contoh:
#   R2_ACCOUNTS=[{"name":"r2-01","account_id":"abc","access_key":"...","secret_key":"...","bucket":"media"},{"name":"r2-02","account_id":"def","access_key":"...","secret_key":"...","bucket":"media"}]
R2_ACCOUNTS=

# TTL presigned URL (Go duration).
R2_PRESIGN_TTL=5m

# Server timeouts (see net/http Server).
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s

# Graceful shutdown deadline (drain active connections).
SHUTDOWN_TIMEOUT=10s

# Per-request downloader resolve deadline. Must stay below HTTP_WRITE_TIMEOUT.
RESOLVE_TIMEOUT=45s

# How long a successfully resolved URL is cached in Redis (when enabled).
RESOLVE_CACHE_TTL=10m

# --- JSON output -------------------------------------------------
# When true, all JSON responses are pretty/indented.
# In development you can also use ?pretty=1 on any endpoint.
PRETTY_JSON=false

# --- Logging -----------------------------------------------------
LOG_LEVEL=info                 # debug | info | warn | error

# --- Browser automation (Playwright) -----------------------------
# Enable the browser engine. Default false keeps the skeleton runnable
# without Chromium/Playwright installed.
BROWSER_ENABLED=false

# Headless mode (true) vs headed mode (false).
BROWSER_HEADLESS=true

# Optional: path to a specific Chromium executable (empty = Playwright default).
BROWSER_EXECUTABLE_PATH=

# Optional: override the browser User-Agent.
BROWSER_USER_AGENT=

# Proxy skeleton (only BROWSER_PROXY_SERVER is used today).
BROWSER_PROXY_SERVER=
BROWSER_PROXY_USERNAME=
BROWSER_PROXY_PASSWORD=

# Default operation & navigation timeouts.
BROWSER_TIMEOUT=30s
BROWSER_NAVIGATION_TIMEOUT=30s

# Max concurrent browser contexts (requests).
BROWSER_MAX_CONCURRENCY=4

# Timeout for closing browser resources during shutdown/session release.
BROWSER_CLEANUP_TIMEOUT=5s

# Retry policy (applied around flaky browser operations).
BROWSER_RETRY_MAX_ATTEMPTS=2
BROWSER_RETRY_BACKOFF=200ms

# --- Provider credentials (reserved for future implementation) ---
# Provider eksternal bisa membutuhkan kredensial sendiri (mis. API key
# upstream). Simpan di sini saat provider tersebut ditambahkan.

# --- Database (PostgreSQL) ---------------------------------------
# Connection string. When empty, PostgreSQL is disabled and metrics are not
# persisted (the API still runs). Example for a local dev install:
#   postgres://postgres:postgres@localhost:5432/rest-api?sslmode=disable
DATABASE_URL=

# Connection pool sizing.
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# Timeout for establishing a database connection.
DATABASE_CONNECT_TIMEOUT=10s

# --- Cache (Redis) -----------------------------------------------
# When empty, Redis is disabled (metrics still persist to PostgreSQL).
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# --- API metrics --------------------------------------------------
# Bounded queue of pending metric events; full queues drop events rather than
# block the request path.
METRICS_QUEUE_SIZE=1024

# --- Access control (Stage 7) --------------------------------------
# API-key authentication, rate limiting, and quota are backed by PostgreSQL
# (accounts, api_keys, plan_policies, quota_usage) and Redis (rate-limit +
# best-effort counters). There is no plaintext key in the environment: keys are
# provisioned via `go run ./cmd/devkey` and stored as SHA-256 hashes only.
#
#   go run ./cmd/devkey -name dev -plan pro -key-name dev-cli
#
# Plans define per-plan rate limits and daily/monthly quotas. They are seeded
# by migration 0002 and can be overridden by editing the plan_policies table.
